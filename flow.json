    {
        "id": "8a1f9a771031a5d2",
        "type": "function",
        "z": "ba419cd70b9242b5",
        "g": "e0e455d2e0871e77",
        "name": "sync_command",
        "func": "let packet_type = msg.topic;\nlet target_device = flow.get('target_device');\nlet type = flow.get('type');\nlet range = flow.get('range');\n\nif(packet_type == 'sync'){\n    if(msg.payload.type == 'sync_check_in'){\n        if(msg.payload.sensor_type == 21){\n            if(target_device == msg.payload.address){\n                msg.payload =  {\n                    address: target_device,\n                    // Master command\n                    data: [0x6C, 0x00, 0x00, 0x7F, 0xFF, 0x00, 0x00, 0xFF, 0xFF, 0x00, 0x00, 0x00, 0x00, 0x3C, range, type]\n                }\n                return msg;\n            }\n        }\n    }\n}",
